    <credit:officialMonthlyIncome rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">90000</credit:officialMonthlyIncome>
    <credit:additionalMonthlyIncome rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35000</credit:additionalMonthlyIncome>
    <credit:totalWorkExperienceMonths rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">264</credit:totalWorkExperienceMonths>
