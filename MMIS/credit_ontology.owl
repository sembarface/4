    <credit:creditHistoryMonths rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</credit:creditHistoryMonths>
    <credit:paymentRegularity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">нет предыдущих выплат</credit:paymentRegularity>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/creditworthiness#dependentCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
