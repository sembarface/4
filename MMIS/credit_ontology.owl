    <rdf:type rdf:resource="http://www.semanticweb.org/creditworthiness#IncomeStability"/>
    <rdfs:label xml:lang="ru">Регулярность и стабильность доходов 07</rdfs:label>
    <credit:incomeVolatility rdf:datatype="http://www.w3.org/2001/XMLSchema#string">небольшие колебания</credit:incomeVolatility>
    <credit:incomePeriodicity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ежемесячно</credit:incomePeriodicity>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/creditworthiness#SelfEmployment">
