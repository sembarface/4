  <rdf:Description rdf:about="http://www.semanticweb.org/creditworthiness#incomeEmployment03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/creditworthiness#IncomeEmployment"/>
    <rdfs:label xml:lang="ru">Доходы и занятость 03</rdfs:label>
